# Claude Title configuration.
#
# Copy to herdr-claude-title/config.env in the first of these that suits you
# (the first one already holding the file wins):
#   1  $XDG_CONFIG_HOME            (when set to an absolute path)
#   2  ~/.config                   (%USERPROFILE%\.config on Windows)
#   3  ~/Library/Application Support on macOS, %APPDATA% on Windows
#
# Every line below is the default, so this file as it stands changes nothing.
# A variable set in the environment overrides the file. Values are taken
# literally: nothing like ${HOME} or ~ is expanded. After a change, run
#   herdr plugin action invoke herdr.claude-title.restart

# ── Naming engine ────────────────────────────────────────────────────────────

# claude: Claude writes each Claude Code session's title from what you asked
#         in it, via your own `claude -p` and subscription; the rules name
#         everything else and fill in until Claude answers.
# rules:  deterministic rules only; nothing leaves the machine.
#HERDR_CLAUDE_TITLE_NAMING_ENGINE=claude

# Model for titles. haiku is fast (~5-10 s) and light on quota.
#HERDR_CLAUDE_TITLE_CLAUDE_MODEL=haiku

# After the first title, ask again once this many new prompts arrived, so
# the title follows the conversation instead of freezing on its opening.
#HERDR_CLAUDE_TITLE_CLAUDE_RETITLE_EVERY_PROMPTS=5

# Give up on one title call after this long.
#HERDR_CLAUDE_TITLE_CLAUDE_TIMEOUT_SECONDS=60

# Path to claude. Empty finds it on PATH, then ~/.local/bin, ~/.claude/local,
# /opt/homebrew/bin and /usr/local/bin (the Herdr server's PATH is often bare).
#HERDR_CLAUDE_TITLE_CLAUDE_BINARY=

# ── What gets named, and how wide ────────────────────────────────────────────

# Longest tab title, in terminal columns (CJK and emoji count two).
#HERDR_CLAUDE_TITLE_TAB_MAX_COLUMNS=30

# Put the tab's position (the key that switches to it) in front: "3 · api".
#HERDR_CLAUDE_TITLE_SHOW_TAB_NUMBER=true

# Put the agent's name in front of what it is doing: "api › claude › ...".
#HERDR_CLAUDE_TITLE_SHOW_AGENT_NAME=false

# Longest git branch in a title, in columns. 0 leaves branches out.
#HERDR_CLAUDE_TITLE_BRANCH_MAX_COLUMNS=12

# Name each pane too, which is what Herdr's goto panel lists panes by.
# Costs one process read per pane rather than per tab.
#HERDR_CLAUDE_TITLE_NAME_PANES=true

# Name a tab after its agent pane even while another pane is focused.
#HERDR_CLAUDE_TITLE_PREFER_AGENT_PANE=false

# Name a workspace holding exactly one tab after that tab. Herdr names the
# row once, from its directory, and never revisits it. Needs a renames file.
#HERDR_CLAUDE_TITLE_NAME_WORKSPACES=false

# Longest workspace row, in columns of the (narrower) sidebar.
#HERDR_CLAUDE_TITLE_WORKSPACE_MAX_COLUMNS=20

# ── Reading ──────────────────────────────────────────────────────────────────

# Read Claude Code transcripts: what a session is about, and which worktree
# its agent is in. Off also turns the Claude engine off.
#HERDR_CLAUDE_TITLE_READ_TRANSCRIPTS=true

# More Claude config homes to read transcripts from, after CLAUDE_CONFIG_DIR
# (or ~/.claude). Separated by ":" (";" on Windows).
#HERDR_CLAUDE_TITLE_EXTRA_CLAUDE_HOMES=/home/you/.claude-work

# ── Logging and state ────────────────────────────────────────────────────────

# debug, info, warn or error. Logs are in `herdr plugin log list`.
#HERDR_CLAUDE_TITLE_LOG_LEVEL=info

# How often the session is read, in milliseconds. Also the fastest a label
# can change.
#HERDR_CLAUDE_TITLE_POLL_INTERVAL_MS=500

# Where names you set by hand are remembered across restarts. Defaults to
# user-renames.json beside this file. Empty keeps them in memory only (and
# leaves workspace rows alone).
#HERDR_CLAUDE_TITLE_USER_RENAMES_FILE=
